climate_index [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#1b4f8a"><TR><TD BGCOLOR="#e8eef6" COLSPAN="3"><B>climate_index</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK</TD><TD ALIGN="LEFT" BALIGN="LEFT">id</TD><TD ALIGN="LEFT" BALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">UK</TD><TD ALIGN="LEFT" BALIGN="LEFT">code</TD><TD ALIGN="LEFT" BALIGN="LEFT">varchar(10)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD><TD ALIGN="LEFT" BALIGN="LEFT">name, region</TD><TD ALIGN="LEFT" BALIGN="LEFT">varchar(200)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD><TD ALIGN="LEFT" BALIGN="LEFT">unit</TD><TD ALIGN="LEFT" BALIGN="LEFT">varchar(20)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD><TD ALIGN="LEFT" BALIGN="LEFT">description</TD><TD ALIGN="LEFT" BALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK</TD><TD ALIGN="LEFT" BALIGN="LEFT">source_id</TD><TD ALIGN="LEFT" BALIGN="LEFT">int → source</TD></TR></TABLE>>];
import_batch [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#1b4f8a"><TR><TD BGCOLOR="#e8eef6" COLSPAN="3"><B>import_batch</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">PK</TD><TD ALIGN="LEFT" BALIGN="LEFT">id</TD><TD ALIGN="LEFT" BALIGN="LEFT">serial</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK</TD><TD ALIGN="LEFT" BALIGN="LEFT">source_id</TD><TD ALIGN="LEFT" BALIGN="LEFT">int → source</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">FK</TD><TD ALIGN="LEFT" BALIGN="LEFT">index_id</TD><TD ALIGN="LEFT" BALIGN="LEFT">int → climate_index</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">IX</TD><TD ALIGN="LEFT" BALIGN="LEFT">file_sha256</TD><TD ALIGN="LEFT" BALIGN="LEFT">varchar(64)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD><TD ALIGN="LEFT" BALIGN="LEFT">file_name, last_modified</TD><TD ALIGN="LEFT" BALIGN="LEFT">varchar</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD><TD ALIGN="LEFT" BALIGN="LEFT">extracted_at</TD><TD ALIGN="LEFT" BALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD><TD ALIGN="LEFT" BALIGN="LEFT">started_at, finished_at</TD><TD ALIGN="LEFT" BALIGN="LEFT">timestamptz</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CK</TD><TD ALIGN="LEFT" BALIGN="LEFT">status</TD><TD ALIGN="LEFT" BALIGN="LEFT">4 valeurs</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CK</TD><TD ALIGN="LEFT" BALIGN="LEFT">rows_* (6 compteurs)</TD><TD ALIGN="LEFT" BALIGN="LEFT">int ≥ 0 (×6)</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"></TD><TD ALIGN="LEFT" BALIGN="LEFT">message</TD><TD ALIGN="LEFT" BALIGN="LEFT">text</TD></TR></TABLE>>];
