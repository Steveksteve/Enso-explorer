digraph E { rankdir=LR; nodesep=0.35; ranksep=0.9; node [shape=plaintext, fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica", fontsize=10, color="#444444", arrowhead=crow, arrowtail=tee, dir=both];
