digraph C { rankdir=TB; nodesep=0.5; ranksep=0.5; node [shape=plaintext, fontname="Helvetica", fontsize=12]; edge [fontname="Helvetica", fontsize=11, color="#444444"];
Source [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#1b4f8a"><TR><TD BGCOLOR="#e8eef6"><B>Source</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">code : str {unique}<BR ALIGN="LEFT"/>name, provider : str<BR ALIGN="LEFT"/>url, documentation_url : str<BR ALIGN="LEFT"/>version : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
Indice [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#1b4f8a"><TR><TD BGCOLOR="#e8eef6"><B>Indice (ClimateIndex)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">code : str {unique} = RONI<BR ALIGN="LEFT"/>name, region : str<BR ALIGN="LEFT"/>unit : str = °C<BR ALIGN="LEFT"/>description : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
Import [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#1b4f8a"><TR><TD BGCOLOR="#e8eef6"><B>Import (ImportBatch)</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">file_name, file_sha256 : str<BR ALIGN="LEFT"/>file_last_modified : str<BR ALIGN="LEFT"/>extracted_at : date<BR ALIGN="LEFT"/>status : Statut<BR ALIGN="LEFT"/>rows_read/inserted/updated : int<BR ALIGN="LEFT"/>rows_unchanged/rejected : int<BR ALIGN="LEFT"/>duplicates_in_file : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
Observation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#b07a00"><TR><TD BGCOLOR="#fff3dd"><B>Observation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">season : Saison<BR ALIGN="LEFT"/>year : int<BR ALIGN="LEFT"/>period : date (mois central)<BR ALIGN="LEFT"/>mean_sst : Decimal [0..1]<BR ALIGN="LEFT"/>anomaly : Decimal<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
Episode [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#6a1b9a"><TR><TD BGCOLOR="#f3e5f5"><FONT POINT-SIZE="8">«calculé, non persisté»</FONT><BR/><B>Episode</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">id : str (EN-1997-05)<BR ALIGN="LEFT"/>phase : el_nino | la_nina<BR ALIGN="LEFT"/>ongoing, truncated_start : bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">n_seasons() : int<BR ALIGN="LEFT"/>peak() : Observation<BR ALIGN="LEFT"/>mean_anomaly() : float<BR ALIGN="LEFT"/>intensity() : str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Source -> Indice [label="publie\n1     1..*", arrowhead=vee];
Source -> Import [label="alimente\n1     0..*", arrowhead=vee];
Indice -> Import [label="concerne\n1     0..*", arrowhead=vee];
Indice -> Observation [label="contient\n1     0..*", dir=both, arrowtail=diamond, arrowhead=vee];
Import -> Observation [label="a écrit (dernière version)\n1     0..*", arrowhead=vee];
Episode -> Observation [label="regroupe\n1     5..*", dir=both, arrowtail=odiamond, arrowhead=vee];
{rank=same; Source; Episode}
}