{
  "openapi": "3.1.0",
  "info": {
    "title": "ENSO Explorer API",
    "description": "API en lecture seule exposant l'indice NOAA RONI (Relative Oceanic Niño Index, ERSST v6) pour explorer les épisodes El Niño / La Niña. Source : NOAA CPC.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "système"
        ],
        "summary": "État de l'API et de la base",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indices": {
      "get": {
        "tags": [
          "indices"
        ],
        "summary": "Liste des indices disponibles et de leur source",
        "operationId": "list_indices_api_v1_indices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/IndexOut"
                  },
                  "type": "array",
                  "title": "Response List Indices Api V1 Indices Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indices/{code}/observations": {
      "get": {
        "tags": [
          "observations"
        ],
        "summary": "Observations d'un indice, filtrées par période",
        "description": "Renvoie les saisons dont le **mois central** est compris entre `start` et `end` inclus.\n\nExemple : `start=1997-01&end=1998-12` renvoie DJF 1997 (janvier) à NDJ 1998 (décembre).",
        "operationId": "list_observations_api_v1_indices__code__observations_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{2,10}$",
              "examples": [
                "RONI"
              ],
              "title": "Code"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mois AAAA-MM (inclus)",
              "examples": [
                "1997-01"
              ],
              "title": "Start"
            },
            "description": "Mois AAAA-MM (inclus)"
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Mois AAAA-MM (inclus)",
              "examples": [
                "1997-01"
              ],
              "title": "End"
            },
            "description": "Mois AAAA-MM (inclus)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Paramètre invalide (format ou début > fin)"
          }
        }
      }
    },
    "/api/v1/indices/{code}/episodes": {
      "get": {
        "tags": [
          "épisodes"
        ],
        "summary": "Épisodes El Niño / La Niña détectés (seuil ±0,5 °C, ≥ 5 saisons)",
        "operationId": "list_episodes_api_v1_indices__code__episodes_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{2,10}$",
              "examples": [
                "RONI"
              ],
              "title": "Code"
            }
          },
          {
            "name": "phase",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "el_nino",
                    "la_nina"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtrer une phase",
              "title": "Phase"
            },
            "description": "Filtrer une phase"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EpisodeOut"
                  },
                  "title": "Response List Episodes Api V1 Indices  Code  Episodes Get"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/indices/{code}/episodes/compare": {
      "get": {
        "tags": [
          "épisodes"
        ],
        "summary": "Compare deux épisodes historiques avec une interprétation prudente",
        "operationId": "compare_episodes_api_v1_indices__code__episodes_compare_get",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{2,10}$",
              "examples": [
                "RONI"
              ],
              "title": "Code"
            }
          },
          {
            "name": "a",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(EN|LN)-\\d{4}-(0[1-9]|1[0-2])$",
              "examples": [
                "EN-1997-05"
              ],
              "title": "A"
            }
          },
          {
            "name": "b",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(EN|LN)-\\d{4}-(0[1-9]|1[0-2])$",
              "examples": [
                "EN-1997-05"
              ],
              "title": "B"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonOut"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          },
          "422": {
            "description": "Identifiants invalides ou identiques"
          }
        }
      }
    },
    "/api/v1/imports": {
      "get": {
        "tags": [
          "traçabilité"
        ],
        "summary": "Derniers imports ETL (provenance des données)",
        "operationId": "list_imports_api_v1_imports_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImportOut"
                  },
                  "title": "Response List Imports Api V1 Imports Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComparisonOut": {
        "properties": {
          "index": {
            "type": "string",
            "title": "Index"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "min_seasons": {
            "type": "integer",
            "title": "Min Seasons"
          },
          "a": {
            "$ref": "#/components/schemas/EpisodeSeries"
          },
          "b": {
            "$ref": "#/components/schemas/EpisodeSeries"
          },
          "findings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Findings"
          },
          "limits": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limits"
          }
        },
        "type": "object",
        "required": [
          "index",
