      },
      "IndexOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "region": {
            "type": "string",
            "title": "Region"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
