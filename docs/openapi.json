        "type": "object",
        "required": [
          "id",
          "phase",
          "label",
          "start",
          "end",
          "start_season",
          "end_season",
          "n_seasons",
          "peak_anomaly",
          "peak_season",
          "mean_anomaly",
          "cumulative_anomaly",
          "intensity",
          "ongoing",
          "truncated_start"
        ],
        "title": "EpisodeOut"
      },
      "EpisodeSeries": {
        "properties": {
          "episode": {
            "$ref": "#/components/schemas/EpisodeOut"
          },
          "values": {
            "items": {
              "$ref": "#/components/schemas/ObservationOut"
            },
            "type": "array",
            "title": "Values"
          }
        },
        "type": "object",
        "required": [
          "episode",
          "values"
        ],
        "title": "EpisodeSeries"
      },
      "ErrorOut": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportOut": {
