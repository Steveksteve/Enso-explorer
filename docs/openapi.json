            ]
          },
          "year": {
            "type": "integer",
            "title": "Year",
            "examples": [
              1997
            ]
          },
          "period": {
            "type": "string",
            "title": "Period",
            "description": "Mois central de la saison, AAAA-MM",
            "examples": [
              "1997-12"
            ]
          },
          "anomaly": {
            "type": "number",
            "title": "Anomaly",
            "description": "Anomalie RONI en °C",
            "examples": [
              2.28
            ]
          },
          "mean_sst": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Sst",
            "description": "SST moyenne Niño 3.4 en °C (absente pour le RONI)",
            "examples": [
              null
            ]
          }
        },
        "type": "object",
        "required": [
          "season",
          "year",
          "period",
          "anomaly",
          "mean_sst"
        ],
        "title": "ObservationOut"
      },
      "ObservationsResponse": {
        "properties": {
          "index": {
            "type": "string",
            "title": "Index"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "source": {
            "$ref": "#/components/schemas/SourceOut"
          },
          "last_import": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ImportOut"
