          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "rows_read": {
            "type": "integer",
            "title": "Rows Read"
          },
          "rows_inserted": {
            "type": "integer",
            "title": "Rows Inserted"
          },
          "rows_updated": {
            "type": "integer",
            "title": "Rows Updated"
          },
          "rows_unchanged": {
            "type": "integer",
            "title": "Rows Unchanged"
          },
          "rows_rejected": {
