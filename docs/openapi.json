          "phase": {
            "type": "string",
            "enum": [
              "el_nino",
              "la_nina"
            ],
            "title": "Phase"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "start": {
            "type": "string",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "title": "End"
          },
          "start_season": {
            "type": "string",
            "title": "Start Season"
          },
          "end_season": {
            "type": "string",
            "title": "End Season"
          },
          "n_seasons": {
            "type": "integer",
            "title": "N Seasons"
          },
          "peak_anomaly": {
            "type": "number",
