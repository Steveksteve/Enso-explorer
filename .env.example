# Copier ce fichier en .env et changer les valeurs. Le fichier .env n'est jamais versionné.

# --- PostgreSQL ---
POSTGRES_DB=enso
POSTGRES_USER=enso
POSTGRES_PASSWORD=change-me-strong-password

# URL utilisée par l'API et l'ETL (dans Docker, l'hôte est le service "db")
DATABASE_URL=postgresql+psycopg://enso:change-me-strong-password@db:5432/enso

# --- API ---
# Origines autorisées par CORS (séparées par des virgules). Inutile derrière Caddy (même origine).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# --- Caddy ---
# "localhost" en local ; en production : le nom de domaine (certificat HTTPS automatique)
DOMAIN=localhost
ACME_EMAIL=admin@example.com
